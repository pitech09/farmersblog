# farmersblog environment configuration
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED FOR ALL ENVIRONMENTS
# ===========================================
# Generate a strong random secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret-key

# Flask environment: 'development' or 'production'
FLASK_ENV=development

# ===========================================
# DATABASE
# ===========================================
# Development: SQLite (default)
# Production: PostgreSQL
# Examples:
#   SQLite: DATABASE_URL=sqlite:///farmersblog_dev.db
#   PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/farmersblog
DATABASE_URL=sqlite:///farmersblog_dev.db

# ===========================================
# UPLOAD STORAGE (Development Only)
# ===========================================
# Local upload folder path (used only when Cloudinary is disabled)
UPLOAD_FOLDER=app/instance/uploads

# Max upload size in bytes (default: 50MB)
MAX_CONTENT_LENGTH=52428800

# ===========================================
# CLOUDINARY (Production Only)
# ===========================================
# Disabled in development, required in production
# CLOUDINARY_ENABLED=true
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# REDIS (Production Only)
# ===========================================
# Required for production caching and rate limiting
# Examples:
#   Redis URL: REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# OPTIONAL SETTINGS
# ===========================================
# Cache type: SimpleCache (dev) or RedisCache (prod)
# CACHE_TYPE=SimpleCache

# Rate limiting storage: memory:// (dev) or redis:// (prod)
# RATELIMIT_STORAGE_URI=memory://

# ===========================================
# SECURITY NOTES
# ===========================================
# - Always set a strong SECRET_KEY in production
# - Production requires: DATABASE_URL (PostgreSQL), Cloudinary creds, REDIS_URL
# - Use HTTPS in production (SESSION_COOKIE_SECURE is auto-set)
# - Never commit .env file to version control
